# Copy this file to .env after rotating the exposed Vectorizer.AI API key.
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=
PORT=4174

# Account and billing setup (never commit real values)
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://imagetovector.org
RESEND_API_KEY=
AUTH_EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# Enable only after migration, mail delivery, webhook and paid export verification.
BILLING_ENABLED=false

# PayPal server-only credentials. Production deployment creates and verifies the monthly plan and webhook.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to live. Use sandbox only with separate sandbox credentials and database.
PAYPAL_ENVIRONMENT=live
